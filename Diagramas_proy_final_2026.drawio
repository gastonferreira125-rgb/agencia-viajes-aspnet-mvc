        <mxCell id="hZMEzx4EaSCuUOmtvK3E-5" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;text-align: center; margin-top: 0px;&quot;&gt;RNE&lt;/h1&gt;&lt;p class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;strong&gt;RNE1:&lt;/strong&gt; El número de ómnibus de un servicio deberá estar comprendido entre 1 y 100.&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;RNE2:&lt;/strong&gt; El tipo de hospedaje solamente podrá ser Hotel STD, Posada o All Inclusive.&lt;/p&gt;&lt;p class=&quot;&quot;&gt;&lt;strong&gt;RNE3:&lt;/strong&gt; El hospedaje seleccionado para un paquete de viaje deberá estar ubicado en el mismo Estado definido como destino del paquete.&lt;/p&gt;&lt;p class=&quot;&quot;&gt;RNE4: El código de Estado deberá ser de 4 caracteres.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;RNE5:&lt;/strong&gt; La cantidad de noches de hospedaje deberá ser menor a la cantidad de días de duración del servicio.&lt;/p&gt;&lt;p class=&quot;&quot;&gt;&lt;strong&gt;RNE6:&lt;/strong&gt; La cantidad de días del paquete se obtiene de la diferencia entre la fecha/hora de partida y la fecha/hora de llegada del servicio seleccionado.&lt;/p&gt;" vertex="1">
          <mxGeometry height="440" width="840" x="280" y="600" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
