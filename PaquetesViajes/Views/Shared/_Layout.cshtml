
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Agencia de Viajes</title>

    <!-- Bootstrap 3 -->
    <link href="@Url.Content("~/Content/bootstrap.min.css")"
          rel="stylesheet" />

    <!-- Estilos propios -->
    <link href="@Url.Content("~/Content/Site.css")"
          rel="stylesheet" />

    <script src="@Url.Content("~/Scripts/modernizr-2.8.3.js")"></script>
</head>

<body>

    <nav class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">

            <div class="navbar-header">

                <button type="button"
                        class="navbar-toggle collapsed"
                        data-toggle="collapse"
                        data-target="#menuPrincipal"
                        aria-expanded="false"
                        aria-controls="menuPrincipal">

                    <span class="sr-only">Abrir menú</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>

                @Html.ActionLink(
                    "Agencia de Viajes",
                    "Index",
                    "Home",
                    new { area = "" },
                    new { @class = "navbar-brand" }
                )

            </div>

            <div id="menuPrincipal"
                 class="collapse navbar-collapse">

                <ul class="nav navbar-nav">

                    <li>
                        @Html.ActionLink("Inicio", "Index", "Home")
                    </li>

                    <li>
                        @Html.ActionLink("Estados", "Listado", "Estado")
                    </li>

                    <li>
                        @Html.ActionLink("Hospedajes", "Listado", "Hospedaje")
                    </li>

                    <li>
                        @Html.ActionLink("Servicios", "Listado", "Servicio")
                    </li>

                    <li>
                        @Html.ActionLink("Paquetes", "Listado", "PaqueteViaje")
                    </li>

                </ul>

            </div>
        </div>
    </nav>

    <div class="container body-content">

        @RenderBody()

        <hr />

        <footer>
            <p>Powered by Romina, Javier y Gastón</p>
        </footer>

    </div>

    <!-- jQuery debe cargarse antes que Bootstrap 3 -->
    <script src="@Url.Content("~/Scripts/jquery-3.4.1.min.js")"></script>
    <script src="@Url.Content("~/Scripts/bootstrap.min.js")"></script>

    @RenderSection("scripts", required: false)

</body>
</html>
