@model EntidadesCompartidas.Hospedaje

<h2>Alta Hospedaje</h2>

<p> @ViewBag.Mensaje </p>

<p> @Html.ActionLink("Volver", "Listado") </p>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
         <!--pedimos el cod interno-->
        <div class="form-group">
            @Html.LabelFor(model => model.CodigoInterno, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.CodigoInterno, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>

        <!--pedimos el nom-->
        <div class="form-group">
            @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>
        <!--pedimos la dire-->
        <div class="form-group">
            @Html.LabelFor(model => model.Direccion, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Direccion, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>
        <!--pedimos el tipo de hospe-->
        <div class="form-group">
            @Html.LabelFor(model => model.TipoHospedaje, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.TipoHospedaje, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>
        <!--pedimosel $ x noche-->
        <div class="form-group">
            @Html.LabelFor(model => model.PrecioPorNoche, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.PrecioPorNoche, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Estado</label>
            <div class="col-md-10">
                @Html.DropDownList("CodigoEstado", (SelectList)ViewBag.ListaEstados, "-- Seleccione un Estado --", new { @class = "form-control" })
            </div>
            <!-- el estado es un objeto aparte por eso va con dd -->
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="ALTA" class="btn btn-default" />
            </div>
        </div>
    </div>
}