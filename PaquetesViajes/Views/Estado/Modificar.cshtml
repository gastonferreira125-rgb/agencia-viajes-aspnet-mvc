@model EntidadesCompartidas.Estado

<h2>Modificar</h2>

<p> @ViewBag.Mensaje </p>  


<p> @Html.ActionLink("Volver", "Listado") </p>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />

        <!-- controles para desplegar el cod son de solo lectura pq no se modifica el id
            displayfor muestra el contenido d ela prop del obj -->
        <div class="form-group">
            @Html.LabelFor(model => model.CodigoEstado, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DisplayFor(model => model.CodigoEstado, new { htmlAttributes = new { @class = "form-control" } })
                @Html.HiddenFor(model => model.CodigoEstado)
                <!-- el displayfor no postea el dato por eso hace falta el hidden para que viaje al pos -->
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Pais, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Pais, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Modificar" class="btn btn-default" />
            </div>
        </div>
    </div>
}