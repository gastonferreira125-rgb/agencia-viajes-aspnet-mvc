
@model IEnumerable<EntidadesCompartidas.Estado>

<h2>Listado de Estados</h2>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info">
        @ViewBag.Mensaje
    </div>
}

<p>
    @Html.ActionLink(
        "Nuevo Estado",
        "Agregar",
        null,
        new { @class = "btn btn-primary" }
    )
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover">

        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>País</th>
                <th class="text-right">Acciones</th>
            </tr>
        </thead>

        <tbody>

            @if (Model != null)
            {
                foreach (EntidadesCompartidas.Estado unE in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => unE.CodigoEstado)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => unE.Nombre)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => unE.Pais)
                        </td>

                        <td class="text-right">
                            <div class="btn-group">

                                <button type="button"
                                        class="btn btn-default btn-sm dropdown-toggle"
                                        data-toggle="dropdown"
                                        aria-haspopup="true"
                                        aria-expanded="false">
                                    Acciones
                                    <span class="caret"></span>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-right">

                                    <li>
                                        @Html.ActionLink(
                                            "Consultar",
                                            "Consultar",
                                            new { pCodigoEstado = unE.CodigoEstado }
                                        )
                                    </li>

                                    <li>
                                        @Html.ActionLink(
                                            "Modificar",
                                            "Modificar",
                                            new { pCodigoEstado = unE.CodigoEstado }
                                        )
                                    </li>

                                    <li>
                                        @Html.ActionLink(
                                            "Eliminar",
                                            "Eliminar",
                                            new { pCodigoEstado = unE.CodigoEstado }
                                        )
                                    </li>

                                    <li role="separator" class="divider"></li>

                                    <li>
                                        @Html.ActionLink(
                                            "Ver Paquetes",
                                            "PaquetesPorEstado",
                                            new { pCodigoEstado = unE.CodigoEstado }
                                        )
                                    </li>

                                    <li>
                                        @Html.ActionLink(
                                            "Ver Hospedajes",
                                            "HospedajesPorEstado",
                                            new { pCodigoEstado = unE.CodigoEstado }
                                        )
                                    </li>

                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>
